{
  "name": "central",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/start-local.mjs dev",
    "build": "next build",
    "start": "node scripts/start-local.mjs start",
    "dev:web": "vite --config vite.config.mts",
    "build:web": "vite build --config vite.config.mts",
    "preview:web": "vite preview --config vite.config.mts",
    "build:apps-script": "node scripts/build-apps-script.mjs",
    "test:cloud": "vitest run tests/cloud",
    "test:web": "vitest run --config tests/web/vitest.config.mts",
    "test:e2e:web": "playwright test --config tests/web/playwright.config.ts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:pwa": "playwright test --config playwright.production.config.ts",
    "db:migrate": "tsx scripts/init-data.ts",
    "data:backup": "tsx scripts/backup.ts",
    "data:restore": "tsx scripts/restore.ts",
    "start:lan": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-lan.ps1",
    "lan:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-lan.ps1",
    "design:check": "node scripts/design-check.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/source-sans-3": "5.3.1",
    "@fullcalendar/react": "7.1.3",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-select": "2.4.1",
    "@tanstack/react-query": "5.104.5",
    "better-sqlite3": "13.0.3",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.60.0",
    "next": "16.4.2",
    "pino": "10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "temporal-polyfill": "1.0.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/google-apps-script": "2.0.13",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "29.1.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22.22.0"
  },
  "type": "module"
}
