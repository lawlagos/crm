# Referência: launchers e CLIs usam o ambiente do processo PowerShell.
# Não é necessário copiar este arquivo; veja docs/onboarding.md.
# Caminho absoluto opcional. Padrão: %LOCALAPPDATA%\Central\data
CENTRAL_DATA_DIR=
# Origens e hosts adicionais somente para modo LAN explícito.
CENTRAL_LAN_ORIGIN=
# Reservado ao launcher: 1 no servidor; ausente/0 em build e testes.
CENTRAL_RUN_JOBS=0
